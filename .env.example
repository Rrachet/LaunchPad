# =====================================================================
# LaunchBoard - Environment Variables (REQUIRED for Render deployment)
# =====================================================================
# Set these in Render dashboard under the backend Web Service:
#   Dashboard -> launchboard-backend -> Environment
# =====================================================================

# --- Required ---
# Your PostgreSQL connection string (Neon / Render Postgres / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Secret for signing JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Secret for express-session
SESSION_SECRET=change-me-to-another-long-random-string

# --- Optional ---

# Set to "true" to return OTP in API responses (dev only, no SMTP needed)
# Set to "false" once SMTP is configured for real email delivery
OTP_DEV_MODE=true

# Google OAuth (optional - only needed for "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the callback URL registered in Google Cloud Console
# Format: https://<your-backend>.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# SMTP (optional - only needed for real email/OTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=

# Frontend URL (used for Google OAuth success redirect)
FRONTEND_GOOGLE_SUCCESS_URL=
