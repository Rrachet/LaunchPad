# Copy this file to .env and fill in real values. Never commit real secrets.

# === Google OAuth (Google Cloud Console) ===
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# EXACTLY match an Authorized redirect URI in Google Cloud Console.
# Local dev:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production (Render) — uncomment and use your Render backend URL:
# GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# Where to redirect the browser after Google sign-in (frontend URL)
FRONTEND_GOOGLE_SUCCESS_URL=http://localhost:5173/google-success
# Production:
# FRONTEND_GOOGLE_SUCCESS_URL=https://your-frontend.onrender.com/google-success

# === App secrets ===
JWT_SECRET=long-random-string
SESSION_SECRET=long-random-string

# === Database ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/launchboard?sslmode=require

# === OTP / SMTP ===
# true => OTP returned in API response (no SMTP needed). false => require SMTP.
OTP_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
